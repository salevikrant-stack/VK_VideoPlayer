{
  "name": "ultimate-video-player",
  "productName": "Ultimate Video Player",
  "version": "1.0.0",
  "description": "Professional FFmpeg Video Player",
  "author": "Your Name",
  "license": "MIT",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win portable --x64"
  },

  "dependencies": {
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3"
  },

  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.ultimatevideoplayer.app",

    "productName": "Ultimate Video Player",

    "asar": true,

    "directories": {
      "output": "dist"
    },

    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**",
      "!**/*.map",
      "!README.md",
      "!LICENSE"
    ],

    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg"
      }
    ],

    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],

      "artifactName": "Ultimate-Video-Player.exe",

      "icon": "src/icons/icon.ico"
    },

    "portable": {
      "artifactName": "Ultimate-Video-Player.exe"
    },

    "compression": "maximum",

    "npmRebuild": false,

    "buildDependenciesFromSource": false
  }
}
